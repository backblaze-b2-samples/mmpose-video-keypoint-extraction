# Backblaze B2 (required) — addressed over the S3-compatible API.
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region of your bucket. The S3 endpoint is derived from it
# (https://s3.<B2_REGION>.backblazeb2.com), so no endpoint is configured here.
B2_REGION=your_region

# Example of what filled-in values look like (placeholders — not real keys):
# B2_APPLICATION_KEY_ID=<your 24-char keyID>
# B2_APPLICATION_KEY=<your 31-char applicationKey, shown once at creation>
# B2_BUCKET_NAME=my-pose-datasets
# B2_REGION=us-west-004

# Optional: base URL for building public object URLs. Only meaningful for a
# public bucket; the app works without it (presigned URLs cover private buckets).
# B2_PUBLIC_URL_BASE=https://my-pose-datasets.s3.us-west-004.backblazeb2.com

# Optional: MMPose engine tuning (all have safe defaults).
# MMPOSE_PREFIX=mmpose-video-keypoint-extraction/
# MMPOSE_DEVICE=auto   # auto → CUDA if present, else CPU (mps is opt-in only)

# Optional: seed script (scripts/seed_pose.py) knobs.
# MMPOSE_DEMO_SESSION=demo-session
# MMPOSE_MAX_FRAMES=16
# MMPOSE_DEMO_VIDEO_URL=<CC-BY clip to decode; defaults to a Blender open movie>
# MMPOSE_USE_DEMO_DATA=1   # fall back to MMPose's Apache-2.0 demo images on fetch failure
# MMPOSE_MODEL_CONFIG=<override the model alias → config, advanced>

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
